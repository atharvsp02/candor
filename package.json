{
  "name": "candor",
  "version": "1.0.0",
  "type": "module",
  "description": "Verifiable anonymous polling on Midnight. One member, one ballot, enforced by zero-knowledge proof.",
  "author": "",
  "license": "MIT",
  "scripts": {
    "compile": "compact compile contracts/candor.compact managed/candor",
    "build": "npm run ui:assets && tsc --noEmit && vite build",
    "setup": "npx tsx src/setup.ts",
    "deploy": "npx tsx src/deploy.ts",
    "cli": "npx tsx src/cli.ts",
    "check-balance": "npx tsx src/check-balance.ts",
    "network": "npx tsx src/network.ts",
    "proof-server:start": "docker compose up -d",
    "proof-server:stop": "docker compose down",
    "clean": "node scripts/clean.mjs",
    "test": "vitest run",
    "test:e2e": "tsx scripts/e2e-check.ts",
    "test:watch": "vitest",
    "address": "npx tsx src/address.ts",
    "dev": "npm run ui:assets && vite",
    "ui:assets": "mkdir -p public/keys public/zkir && cp -r managed/candor/keys/* public/keys/ && cp -r managed/candor/zkir/* public/zkir/",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/dapp-connector-api": "^4.0.1",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@scure/bip39": "2.2.0",
    "buffer": "^6.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rxjs": "^7.8.2",
    "semver": "^7.8.5",
    "three": "0.186.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "midnight",
    "zero-knowledge",
    "privacy",
    "voting",
    "compact",
    "merkle-tree",
    "nullifier"
  ],
  "overrides": {
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0",
    "three": "0.186.0"
  }
}